---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE, SITE_DESCRIPTION_FR } from "../consts";
import { getEntry } from "astro:content";

const about = await getEntry("about", "index");
if (!about) {
  throw new Error('Missing about content at src/content/about/index.md');
}
const { Content } = await about.render();
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION_FR}>
  <main>
    <div class="page-header">
      <h1 class="page-title normal-text italic se">about</h1>
    </div>
    <div class="grid-2">
      <div class="text-grid">
        <Content />
      </div>
      <div class="image-grid"></div>
    </div>
  </main>
</Layout>

<style>
  .text-grid :global(h2) {
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-l);
    font-family: "IBM Plex Mono", monospace;
    font-weight: 400;
    font-style: italic;
    font-size: var(--step--1);
  }

  .text-grid :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-m);
  }

  .text-grid :global(li) {
    margin-bottom: var(--space-m);
  }

  .text-grid :global(a) {
    color: var(--obsidian-accent);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  .text-grid :global(a:hover) {
    color: light-dark(var(--text-primary), var(--text-primary-dark));
  }

  .normal-text {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 400;
    font-style: normal;
    font-size: var(--step--1);
  }

  .grid-2 {
    margin: var(--space-xl) 0;
    text-align: left;
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-s);
    margin: 0 auto;
    padding-bottom: var(--space-xl);
  }

  @media screen and (max-width: 720px) {
    .grid-2 {
      grid-template-columns: 1fr;
    }

    .image-grid {
      order: -1;
      width: 100%;
    }

    .image-about {
      width: 100%;
      margin-bottom: var(--space-m);
    }
  }

  .image-grid {
    justify-self: end;
  }

  .italic {
    font-style: italic;
  }
</style>
